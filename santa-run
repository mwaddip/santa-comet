#!/usr/bin/env bash
# santa-run <impl-path> <santa-dir> <out-dir> — Comet as a self-contained runner (SANTA's runner-integration §3):
# `runner.js run` checks its grader (src/harness/) and selection against the SANTA checkout's oracles, selects by
# runner.json, runs and grades every selected file, and writes results.json and actuals/.
#
# SANTA owns the impl checkout: it clones runner.json's `impl`
# (https://github.com/fleet-sdk/fleet.git#master) into a per-runner cache and
# passes the containing dir as $1; our implementation under test is at $1/fleet.
#
# Fleet is a pnpm monorepo with workspace:^ inter-deps, which do not resolve from
# outside the workspace — so Comet JOINS it: rsync package/ in as
# packages/santa-comet/ (fleet's pnpm-workspace.yaml globs packages/*), install,
# build the filtered dependency closure, run. Mutating the checkout is fine — it
# is santa's disposable per-runner cache.
#
# Toolchain self-provisioned (mise.toml: node 22, pnpm 9) — re-exec once under
# `mise exec` so node+pnpm are on PATH for the whole subtree. The orchestrator
# stays toolchain-agnostic; `mise` on PATH is the one bootstrap dep. santa-run
# trusts its own co-located config (toml and script live together — no new surface).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${SANTA_MISE_ACTIVE:-}" ]; then
  mise trust "$here/mise.toml" >/dev/null
  mise --cd "$here" install
  # `mise --cd` changes the working directory: resolve the three paths (and this script) first
  set -- "$(realpath "$1")" "$(realpath "$2")" "$(realpath -m "$3")"
  exec env SANTA_MISE_ACTIVE=1 mise --cd "$here" exec -- "$here/$(basename "$0")" "$@"
fi
# --- node + pnpm now on PATH ---
impl="$(cd "$1" && pwd)"
SANTA="$(realpath "$2")"
OUT="$(realpath -m "$3")"   # the runner makes it, after it has checked the out-dir is allowed (§3)
fleet="$impl/fleet"

rsync -a --delete --exclude node_modules --exclude dist \
  "$here/package/" "$fleet/packages/santa-comet/"
cd "$fleet"
# --no-frozen-lockfile is explicit: under CI=true pnpm defaults to frozen and
# would refuse the lockfile-unknown workspace package we just dropped in.
pnpm install --no-frozen-lockfile >/dev/null
# Build comet + its workspace dependency closure (serializer → common, crypto),
# topological order. Quoted: "..." is pnpm filter syntax, not a glob.
pnpm --filter "santa-comet..." run build >/dev/null
# --max-old-space-size: a bounded file's child runs under the same flags, and V8's own default heap limit could
# stop a row within its budget; a large ceiling leaves the bound to the watchdog (src/harness/bounds.ts).
# exec: the runner takes this script's pid, so a signal sent to santa-run reaches it (and it takes a bounded child's
# group with it, runner-integration §3a); a runner left as bash's child would run on under pid 1 after bash died.
exec node --max-old-space-size=65536 packages/santa-comet/dist/runner.js run "$here/runner.json" "$SANTA" "$OUT"
